#!/usr/bin/lua

local site = require "gluon.site"
local util = require "gluon.util"

-- noderoute writes these files while it configures the client network, so
-- uradvd only picks up changes when it is restarted afterwards.

local range6 = util.readfile("/tmp/range6")
if range6 then
	io.write("-i br-client -p " .. range6)
end

local addr6 = util.readfile("/tmp/addr6")
if addr6 then
	io.write(" --rdnss " .. addr6)
end

-- Only a node that translates IPv4 for its clients announces a NAT64
-- prefix (RFC 8781); the file is absent on all other nodes.
local pref64 = util.readfile("/tmp/pref64")
if pref64 then
	io.write(" --pref64 " .. pref64)
end

-- Everything our clients send leaves through a tunnel, so they are told
-- what fits into it (RFC 4861). noderoute writes the file while that is
-- known, and never writes a value uradvd would refuse to advertise.
local adv_mtu = util.readfile("/tmp/adv_mtu")
if adv_mtu then
	io.write(" --adv-link-mtu " .. adv_mtu)
end

if site.radvd() then
	if site.radvd.preferred_lifetime() then
		io.write(" --preferred-lifetime " .. site.radvd.preferred_lifetime())
	end
	if site.radvd.valid_lifetime() then
		io.write(" --valid-lifetime " .. site.radvd.valid_lifetime())
	end
end
